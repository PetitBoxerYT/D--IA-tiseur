{
  "manifest_version": 3,
  "name": "De-IA-tiseur Google Search",
  "version": "1.0",
  "description": "Retire les blocs IA génératifs des pages de résultats Google.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.fr/search*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
